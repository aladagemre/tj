#!/usr/bin/env bash
# Test double for ssh: runs the command against a second throwaway tmux server
# instead of reaching a host, so remote behaviour is exercised with no network.
# A host listed in TJ_FAKE_SSH_DEAD exits 255, which is what real ssh returns
# when it cannot connect at all.
set -u

[[ -n ${TJ_SSH_LOG:-} ]] && printf '%s\n' "$*" >>"$TJ_SSH_LOG"

host=""
cmd=()
while (( $# )); do
  if [[ -n $host ]]; then
    cmd+=("$1"); shift; continue
  fi
  case $1 in
    -o|-l|-p|-i|-F|-b|-c|-E|-D|-L|-R) shift 2 ;;
    -*) shift ;;
    *)  host=$1; shift ;;
  esac
done

case " ${TJ_FAKE_SSH_DEAD:-} " in
  *" $host "*) exit 255 ;;
esac

(( ${#cmd[@]} )) || exit 0
# The command always begins with `tmux`, which resolves back to the fake tmux
# above; pointing TJ_TEST_SOCKET at the remote server is what makes it "remote".
# ssh_q callers hand the whole remote command over as ONE already-composed
# string (its own embedded quoting intact), so cmd has exactly one element and
# must be re-split by the shell as-is. A caller that instead lists the remote
# command as separate words (the way `ssh -t host tmux attach -t name` reads
# on a real command line) leaves cmd with one element per word; %q-quoting
# each of those before rejoining is what makes them survive the shell's
# second parse untouched, so a tmux format's leading '#' is not read back as
# a comment.
if (( ${#cmd[@]} > 1 )); then
  printf -v remote_cmd '%q ' "${cmd[@]}"
else
  remote_cmd=${cmd[0]}
fi
exec env TJ_TEST_SOCKET="${TJ_FAKE_SSH_REMOTE_SOCKET:?}" bash -c "$remote_cmd"
