#!/usr/bin/env bash
# tj — jump between tmux sessions, most recently used first.
#
#   tj              open the picker (attach from outside tmux, switch from inside)
#   tj <name>       jump straight to a session (fuzzy, first match wins)
#   tj --list       print the formatted session list (used by fzf reload)
#   tj --preview X  render the preview pane for session X (used by fzf)
#   tj --version    print the version
#
# Keys inside the picker:
#   enter    attach / switch to the highlighted session
#   ctrl-x   kill the highlighted session
#   ctrl-n   create a new session named after whatever you typed
#   ctrl-/   toggle the preview pane
#   esc      quit

set -uo pipefail

VERSION=0.1.0

# BSD readlink has no -f; fall back to resolving the symlink by hand.
if self="$(readlink -f "$0" 2>/dev/null)"; then :; else
  self="$0"
  while [[ -L $self ]]; do
    target="$(readlink "$self")"
    case $target in /*) self="$target" ;; *) self="$(dirname "$self")/$target" ;; esac
  done
  self="$(cd "$(dirname "$self")" && pwd)/$(basename "$self")"
fi

die() { printf '%s\n' "$*" >&2; exit 1; }

command -v tmux >/dev/null || die "tmux is not installed"

# ---------------------------------------------------------------- remote hosts

# Hosts to ask for sessions, one per line. TJ_HOSTS (space separated) wins over
# the config file. With neither set tj runs no ssh at all, which is what keeps
# the local-only path exactly as fast as it has always been.
tj_hosts() {
  local f line hosts=()
  if [[ -n ${TJ_HOSTS:-} ]]; then
    read -r -a hosts <<<"$TJ_HOSTS"
  else
    f="${XDG_CONFIG_HOME:-$HOME/.config}/tj/hosts"
    [[ -r $f ]] || return 0
    while IFS= read -r line || [[ -n $line ]]; do
      line=${line%%#*}
      line=${line//[[:space:]]/}
      [[ -n $line ]] && hosts+=("$line")
    done <"$f"
  fi
  (( ${#hosts[@]} )) || return 0
  printf '%s\n' "${hosts[@]}"
}

HOSTS=$(tj_hosts)

# "local" labels this machine in the host column, so it cannot also name a
# remote host without making the column ambiguous.
[[ $'\n'$HOSTS$'\n' == *$'\n'local$'\n'* ]] &&
  die "'local' is a reserved host name — rename it in your tj hosts config"

# The session name is field 2 normally and field 3 once a host column exists.
# Everything that reads the name asks this variable instead of hard-coding it.
# shellcheck disable=SC2034
if [[ -n $HOSTS ]]; then NAMEF=3; else NAMEF=2; fi

# ---------------------------------------------------------------- formatting

# GNU coreutils and BSD/macOS disagree on how to format a unix timestamp.
fmt_date() {
  date -d "@$1" '+%d %b' 2>/dev/null || date -r "$1" '+%d %b' 2>/dev/null || echo "old"
}

# human_age <unix-ts> -> "now" / "12m" / "3h" / "5d" / "14 Jun"
human_age() {
  local ts=$1 now age
  now=$(date +%s)
  [[ $ts -eq 0 ]] && { echo "never"; return; }
  age=$(( now - ts ))
  if   (( age < 60 ));     then echo "now"
  elif (( age < 3600 ));   then echo "$(( age / 60 ))m"
  elif (( age < 86400 ));  then echo "$(( age / 3600 ))h"
  elif (( age < 604800 )); then echo "$(( age / 86400 ))d"
  else fmt_date "$ts"
  fi
}

# One list row. The host column exists only when hosts are configured, which is
# what keeps today's output — and the name's field index — untouched for anyone
# not using the feature. Colouring the host is safe: fzf strips ANSI both when
# expanding {n} and when printing the selected line.
emit_row() {
  local mark=$1 host=$2 name=$3 age=$4 wins=$5 path=$6
  if [[ -n $HOSTS ]]; then
    printf '%b \033[38;5;110m%-8s\033[0m %-18s \033[38;5;244m%6s  %s  %s\033[0m\n' \
      "$mark" "$host" "$name" "$age" "$wins" "$path"
  else
    printf '%b %-18s \033[38;5;244m%6s  %s  %s\033[0m\n' \
      "$mark" "$name" "$age" "$wins" "$path"
  fi
}

# Sessions, most recently attached first. Never-attached ones fall back to
# their creation time so they still land somewhere sensible.
list_sessions() {
  local current="" ts name wins att path age mark home_short
  [[ -n ${TMUX:-} ]] && current=$(tmux display-message -p '#S' 2>/dev/null)

  tmux list-sessions \
    -F '#{?session_last_attached,#{session_last_attached},#{session_created}}|#{session_name}|#{session_windows}|#{?session_attached,1,0}|#{session_path}' \
    2>/dev/null | sort -t'|' -rn -k1,1 |
  while IFS='|' read -r ts name wins att path; do
    age=$(human_age "$ts")
    if   [[ $name == "$current" ]]; then mark=$'\033[32m●\033[0m'
    elif [[ $att == 1 ]];           then mark=$'\033[33m○\033[0m'
    else                                 mark=$'\033[38;5;240m·\033[0m'
    fi
    home_short="${path/#$HOME/\~}"
    emit_row "$mark" local "$name" "$age" "${wins}w" "$home_short"
  done
}

render_preview() {
  local name=$1
  [[ -z $name ]] && return 0
  printf '\033[1m%s\033[0m\n' "$name"
  tmux list-windows -t "$name" \
    -F '  #{window_index}: #{window_name}#{?window_active, *,}  (#{pane_current_command})' 2>/dev/null
  printf '\033[38;5;244m%s\033[0m\n' "────────────────────────────────────────"
  tmux capture-pane -ep -t "$name" 2>/dev/null | tail -n 40
}

# --------------------------------------------------------------- transitions

enter_session() {
  local name=$1
  if [[ -n ${TMUX:-} ]]; then
    tmux switch-client -t "$name"
  else
    tmux attach-session -t "$name"
  fi
}

create_session() {
  local name=$1
  tmux has-session -t "=$name" 2>/dev/null && { enter_session "$name"; return; }
  if [[ -n ${TMUX:-} ]]; then
    tmux new-session -d -s "$name" -c "$PWD" && tmux switch-client -t "$name"
  else
    tmux new-session -s "$name" -c "$PWD"
  fi
}

# ---------------------------------------------------------------- entrypoints

case "${1:-}" in
  --hosts)   [[ -n $HOSTS ]] && printf '%s\n' "$HOSTS"; exit 0 ;;
  --list)    list_sessions; exit 0 ;;
  --preview) render_preview "${2:-}"; exit 0 ;;
  -V|--version) echo "tj $VERSION"; exit 0 ;;
  -h|--help) awk 'NR>1 && /^#/ { sub(/^# ?/, ""); print; next } NR>1 { exit }' "$self"; exit 0 ;;
esac

tmux has-session 2>/dev/null || {
  # Nothing running at all: just start something.
  create_session "${1:-main}"; exit $?
}

# Direct jump: `tj api-gateway`
if [[ -n ${1:-} ]]; then
  match=$(tmux list-sessions -F '#{session_name}' 2>/dev/null | grep -i -- "$1" | head -1)
  [[ -n $match ]] && { enter_session "$match"; exit 0; }
  create_session "$1"; exit 0
fi

command -v fzf >/dev/null || die "fzf is not installed (sudo apt install fzf)"

out=$(list_sessions | fzf \
  --ansi \
  --reverse \
  --no-sort \
  --print-query \
  --expect=ctrl-n \
  --prompt='session > ' \
  --header=$'enter switch · ctrl-x kill · ctrl-n new · ctrl-/ preview' \
  --preview="\"$self\" --preview {2}" \
  --preview-window='right,50%,wrap,border-left' \
  --bind='ctrl-/:toggle-preview' \
  --bind="ctrl-x:execute-silent(tmux kill-session -t {2})+reload(\"$self\" --list)")

query=$(sed -n 1p <<<"$out")
key=$(sed -n 2p <<<"$out")
line=$(sed -n 3p <<<"$out")

if [[ $key == ctrl-n ]]; then
  [[ -z $query ]] && die "ctrl-n needs a name: type one first"
  create_session "$query"
  exit 0
fi

[[ -z $line ]] && exit 0
enter_session "$(awk '{print $2}' <<<"$line")"
